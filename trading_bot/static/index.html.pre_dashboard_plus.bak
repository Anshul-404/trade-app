<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trading Bot — Live Market Chart</title>
  <link rel="stylesheet" href="/static/style.css" />
  <script src="https://unpkg.com/lightweight-charts@5.0.8/dist/lightweight-charts.standalone.production.js"></script>
  <link rel="stylesheet" href="/static/options_paper.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand"><span class="brand-icon">◈</span><div><strong>Trading Bot</strong><small>READ-ONLY MARKET TERMINAL</small></div></div>
    <div class="top-right"><span class="status-dot" id="status-dot"></span><span id="feed-state">Connecting…</span><span class="rule"></span><span id="clock"></span></div>
  </header>
  <main>
    <section class="summary">
      <div><span class="eyebrow">DHANHQ · LIVE MARKET DATA</span><h1 id="symbol">NIFTY 50</h1><div class="descriptor">Candlestick chart <span>•</span> India Standard Time</div></div>
      <div class="quote"><span class="eyebrow">LAST TRADED PRICE</span><div id="last-price">—</div><div class="muted" id="last-tick">Awaiting feed</div></div>
    </section>
    <div class="market-layout">
    <section class="workspace">
      <div class="toolbar"><div class="timeframes" role="group" aria-label="Chart timeframe"><button class="active" data-tf="1">1m</button><button data-tf="2">2m</button><button data-tf="5">5m</button><button data-tf="10">10m</button><button data-tf="15">15m</button><button data-tf="60">1h</button></div><div class="chart-info"><span class="pill">Candlestick</span><span id="bar-count">0 candles</span></div></div>
      <div id="chart"></div>
      <div class="below"><span>Source: DhanHQ Data APIs</span><span id="hist-state">Loading historical candles…</span><span>Real orders disabled · paper trading available</span></div>
    </section>
    <aside class="op-panel" aria-label="Option chain and paper trading">
      <h2>NIFTY Option Chain <span class="op-muted">· DhanHQ</span></h2>
      <p class="op-subtitle">NIFTY 50 spot underlying · Index security 13 · PAPER ONLY</p>
      <div class="op-head">
        <label><span class="op-label">Option expiry</span><select id="op-expiry" aria-label="Option expiry"></select></label>
        <button class="op-btn" id="op-refresh" type="button">Refresh</button>
      </div>
      <p class="op-muted"><span id="op-underlying">Loading spot price…</span> · <span id="op-age">—</span></p>
      <div class="op-table-wrap"><table class="op-table">
        <thead><tr><th>CE OI</th><th>CE LTP</th><th>Strike</th><th>PE LTP</th><th>PE OI</th></tr></thead>
        <tbody id="op-rows"></tbody>
      </table></div>
      <h3>Paper Trading <span class="op-muted">· Simulated orders only</span></h3>
      <div class="op-selected op-muted" id="op-selected">Select a CE or PE contract from the chain</div>
      <div class="op-actions">
        <label><span class="op-label">Lots</span><input id="op-lots" type="number" min="1" max="20" step="1" value="1"/></label>
        <button class="op-btn op-buy" id="op-buy" type="button" disabled>PAPER BUY</button>
        <button class="op-btn op-sell" id="op-sell" type="button" disabled>PAPER SELL</button>
      </div>
      <div class="op-message" id="op-message" role="status"></div>
      <div class="op-stats">
        <div class="op-stat"><span>Virtual cash</span><strong id="op-cash">—</strong></div>
        <div class="op-stat"><span>Est. equity</span><strong id="op-equity">—</strong></div>
        <div class="op-stat"><span>Realized P&amp;L</span><strong id="op-realized">—</strong></div>
        <div class="op-stat"><span>Unrealized P&amp;L</span><strong id="op-unrealized">—</strong></div>
      </div>
      <h3>Open positions</h3><ul class="op-items" id="op-positions"></ul>
      <h3>Latest paper trades</h3><ul class="op-items" id="op-trades"></ul>
      <p class="op-warning">1 lot = <span id="op-lot-size">—</span> units (verify with Dhan for each expiry). BUY uses ask; SELL closes existing longs at bid. No real orders, fees, slippage, margin, or expiry settlement. Refresh chain to value positions.</p>
    </aside>
    </div>
    <p class="notice" id="notice">Waiting for historical market data and the live connection. Market hours: Monday–Friday, 9:15 AM–3:30 PM IST (normal NSE session; holidays may differ).</p>
  </main>
  <footer>Trading Bot · Chart data for personal analysis · Built with <a href="https://www.tradingview.com/" target="_blank" rel="noopener noreferrer">TradingView Lightweight Charts™</a></footer>
  <script src="/static/app.js"></script>
  <script src="/static/structure_layer.js"></script>
  <script src="/static/zones_layer.js"></script>
  <script src="/static/options_paper.js"></script>
</body>
</html>
